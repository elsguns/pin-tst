<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="res_config_settings_view_form" model="ir.ui.view">
      <field name="name">res.config.settings.view.form.inherit.dhl_ecommerce</field>
      <field name="model">res.config.settings</field>
      <field name="priority" eval="15"/>
      <field name="inherit_id" ref="base.res_config_settings_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//form" position="inside">
          <app data-string="DHL eCommerce" string="DHL eCommerce" name="dhl_ecommerce">
            <block title="DHL eCommerce" name="dhl_ecommerce_settings_block">
              <setting id="dhl_ecommerce_webhook_url" string="Webhook URL"
                       help="URL to which DHL eCommerce shipment data will be POSTed.">
                <field name="webhook_url"/>
              </setting>
              <setting id="dhl_ecommerce_trigger_type" string="Send Webhook When"
                       help="Determine when the webhook should be triggered.">
                <field name="trigger_type"/>
              </setting>
            </block>
          </app>
        </xpath>
      </field>
    </record>

  </data>
</odoo>
