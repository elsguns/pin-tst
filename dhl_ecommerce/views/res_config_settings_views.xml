<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="res_config_settings_view_form" model="ir.ui.view">
      <field name="name">res.config.settings.view.form.inherit.dhl_ecommerce</field>
      <field name="model">res.config.settings</field>
      <field name="priority" eval="15"/>
      <field name="inherit_id" ref="base.res_config_settings_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//div[hasclass('settings')]" position="inside">
          <div class="app_settings_block"
               data-string="DHL eCommerce"
               string="DHL eCommerce"
               data-key="dhl_ecommerce">
            <h2>DHL eCommerce</h2>
            <div class="row mt16 o_settings_container">
              <div class="col-12 o_setting_box">
                <div class="o_setting_left_pane"/>
                <div class="o_setting_right_pane">
                  <div>
                    <group>
                      <field name="webhook_url" string="Webhook URL"/>
                      <field name="trigger_type" string="Send Webhook When"/>
                    </group>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </xpath>
      </field>
    </record>

  </data>
</odoo>
