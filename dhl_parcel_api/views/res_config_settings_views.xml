<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_config_settings_view_form_dhl_parcel_api" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.dhl_parcel_api</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="20"/>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[hasclass('settings')]" position="inside">
        <div class="app_settings_block"
             data-string="DHL Parcel API"
             string="DHL Parcel API"
             data-key="dhl_parcel_api">
          <h2>DHL Parcel API</h2>
          <div class="row mt16 o_settings_container">
            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_right_pane">
                <span class="o_form_label">Credentials</span>
                <div class="text-muted">
                  Obtained from My DHL Parcel &gt; Settings &gt; API Keys.
                </div>
                <div class="content-group">
                  <div class="mt16">
                    <field name="dhl_parcel_user_id"/>
                    <field name="dhl_parcel_api_key" password="True"/>
                    <field name="dhl_parcel_account_id"/>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_right_pane">
                <span class="o_form_label">Shipper Address</span>
                <div class="text-muted">
                  Used as the sender on every label.
                </div>
                <div class="content-group">
                  <div class="mt16">
                    <field name="dhl_parcel_shipper_company"/>
                    <field name="dhl_parcel_shipper_street"/>
                    <field name="dhl_parcel_shipper_number"/>
                    <field name="dhl_parcel_shipper_postal_code"/>
                    <field name="dhl_parcel_shipper_city"/>
                    <field name="dhl_parcel_shipper_country_code"/>
                    <field name="dhl_parcel_shipper_phone"/>
                    <field name="dhl_parcel_shipper_email"/>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
