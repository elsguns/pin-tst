<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="res_config_settings_view_form_dhl_parcel_api" model="ir.ui.view">
      <field name="name">res.config.settings.view.form.inherit.dhl_parcel_api</field>
      <field name="model">res.config.settings</field>
      <field name="priority" eval="20"/>
      <field name="inherit_id" ref="base.res_config_settings_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//form" position="inside">
          <app data-string="DHL Parcel API" string="DHL Parcel API" name="dhl_parcel_api">
            <block title="Credentials" name="dhl_parcel_api_credentials_block">
              <setting id="dhl_parcel_user_id_setting" string="User ID"
                       help="UUID issued together with the API key in My DHL Parcel.">
                <field name="dhl_parcel_user_id"/>
              </setting>
              <setting id="dhl_parcel_api_key_setting" string="API Key"
                       help="Secret key issued in My DHL Parcel. Shown once at creation.">
                <field name="dhl_parcel_api_key" password="True"/>
              </setting>
              <setting id="dhl_parcel_account_id_setting" string="Account ID"
                       help="Short DHL account number, e.g. 08500001.">
                <field name="dhl_parcel_account_id"/>
              </setting>
            </block>
            <block title="Shipper Address" name="dhl_parcel_api_shipper_block">
              <setting id="dhl_parcel_shipper_company_setting" string="Company Name">
                <field name="dhl_parcel_shipper_company"/>
              </setting>
              <setting id="dhl_parcel_shipper_street_setting" string="Street">
                <field name="dhl_parcel_shipper_street"/>
              </setting>
              <setting id="dhl_parcel_shipper_number_setting" string="Number">
                <field name="dhl_parcel_shipper_number"/>
              </setting>
              <setting id="dhl_parcel_shipper_postal_code_setting" string="Postal Code">
                <field name="dhl_parcel_shipper_postal_code"/>
              </setting>
              <setting id="dhl_parcel_shipper_city_setting" string="City">
                <field name="dhl_parcel_shipper_city"/>
              </setting>
              <setting id="dhl_parcel_shipper_country_code_setting" string="Country Code"
                       help="ISO-2 country code, e.g. BE.">
                <field name="dhl_parcel_shipper_country_code"/>
              </setting>
              <setting id="dhl_parcel_shipper_phone_setting" string="Phone">
                <field name="dhl_parcel_shipper_phone"/>
              </setting>
              <setting id="dhl_parcel_shipper_email_setting" string="Email">
                <field name="dhl_parcel_shipper_email"/>
              </setting>
            </block>
          </app>
        </xpath>
      </field>
    </record>

  </data>
</odoo>
