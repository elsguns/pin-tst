<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_order_form_dhl_parcel_api" model="ir.ui.view">
    <field name="name">sale.order.form.inherit.dhl_parcel_api</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_open_dhl_parcel_wizard"
                type="object"
                string="DHL shipment"
                class="oe_highlight"
                invisible="state not in ('sale', 'done')"/>
      </xpath>
      <xpath expr="//field[@name='client_order_ref']" position="after">
        <field name="dhl_parcel_tracker_code" readonly="1"/>
        <field name="dhl_parcel_shipment_id" invisible="1"/>
      </xpath>
    </field>
  </record>
</odoo>
