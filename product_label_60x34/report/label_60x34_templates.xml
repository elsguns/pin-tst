<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_label_60x34">
        <t t-call="web.html_container">
            <!-- Kill the default body margin and the Bootstrap .container side
                 padding so the label uses the full 56mm printable width. -->
            <style>
                html, body { margin: 0 !important; padding: 0 !important; }
                body.container, .container { max-width: none !important; padding: 0 !important; margin: 0 !important; }
            </style>
            <!-- quantity = {product: [(barcode, qty), ...]} built by _prepare_data.
                 Loop product -> barcode tuples -> qty copies, one label per page. -->
            <t t-foreach="quantity.items()" t-as="barcode_and_qty_by_product">
                <t t-set="product" t-value="barcode_and_qty_by_product[0]"/>
                <t t-foreach="barcode_and_qty_by_product[1]" t-as="barcode_and_qty">
                    <t t-set="barcode" t-value="barcode_and_qty[0]"/>
                    <t t-foreach="range(barcode_and_qty[1])" t-as="copy">
                        <!-- padding-top (not margin-top) gives a real gap above the
                             barcode without margin-collapsing through the parent. -->
                        <div t-attf-style="box-sizing:border-box;width:100%;padding-top:1mm;text-align:center;font-family:Arial,sans-serif;{{'' if (barcode_and_qty_by_product_first and barcode_and_qty_first and copy_first) else 'page-break-before:always;'}}">
                            <t t-if="barcode">
                                <div t-out="barcode" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'quiet': 0, 'width': 700, 'height': 260, 'img_style': 'width:59mm;height:19mm;display:block;margin:0 auto;'}"/>
                                <div style="font-size:10pt;line-height:1;margin-top:0.5mm;"><span t-esc="barcode"/></div>
                            </t>
                            <t t-else="">
                                <div style="font-size:10pt;line-height:1;color:#888;">No barcode</div>
                            </t>
                            <div style="font-size:9pt;font-weight:bold;line-height:1;max-height:3.5mm;overflow:hidden;margin-top:2mm;">
                                <span t-field="product.name"/>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>
