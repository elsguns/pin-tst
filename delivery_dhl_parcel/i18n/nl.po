#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/dhl_parcel_line.py:0
msgid ""
"Envelope 50 to 500 g is only available for shipments to the Netherlands "
"(destination: %s)."
msgstr ""
"Envelop 50 tot 500 gram is alleen beschikbaar voor zendingen naar Nederland "
"(bestemming: %s)."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid "Pick a Parcel type on the DHL shipping method '%s'."
msgstr "Kies een Pakkettype op de DHL-verzendmethode '%s'."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"DHL Parcel does not deliver to the following countries: %s.\n"
"Remove them from the Countries field."
msgstr ""
"DHL Parcel verzendt niet naar de volgende landen: %s.\n"
"Verwijder deze uit het Countries-veld."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"The parcel type '%(ptype)s' is only available for shipments to %(allowed)s.\n"
"Remove these countries from the Countries field, or pick a different parcel "
"type: %(wrong)s"
msgstr ""
"Het pakkettype '%(ptype)s' is enkel beschikbaar voor zendingen naar "
"%(allowed)s.\n"
"Verwijder deze landen uit het Countries-veld, of kies een ander pakkettype: "
"%(wrong)s"

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"The parcel type '%(ptype)s' is only available for private recipients. "
"'%(partner)s' is a company."
msgstr ""
"Het pakkettype '%(ptype)s' is enkel beschikbaar voor particuliere "
"ontvangers. '%(partner)s' is een bedrijf."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"The parcel type '%(ptype)s' is only available for business recipients. "
"'%(partner)s' is a private individual."
msgstr ""
"Het pakkettype '%(ptype)s' is enkel beschikbaar voor zakelijke ontvangers. "
"'%(partner)s' is een particulier."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"Add at least one parcel in the DHL Parcels tab on this delivery, or pick a "
"DHL shipping method with a fixed parcel type."
msgstr ""
"Voeg minstens één pakket toe in het DHL Parcels-tabblad op deze delivery, "
"of kies een DHL-verzendmethode met een vast pakkettype."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"One of the parcels in the DHL Parcels tab has no type. Set the type before "
"validating."
msgstr ""
"Eén van de pakketten in het DHL Parcels-tabblad heeft geen type. Vul het "
"type aan vóór je valideert."

