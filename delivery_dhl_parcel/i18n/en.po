msgid ""
"Envelop 50 tot 500 gram is alleen beschikbaar voor zendingen naar Nederland "
"(bestemming: %s)."
msgstr ""
"Envelope 50 to 500 g is only available for shipments to the Netherlands "
"(destination: %s)."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid "Kies een Parcel type op de DHL-verzendmethode '%s'."
msgstr "Pick a Parcel type on the DHL shipping method '%s'."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"DHL Parcel verzendt niet naar de volgende landen: %s.\n"
"Verwijder deze uit het Countries-veld."
msgstr ""
"DHL Parcel does not deliver to the following countries: %s.\n"
"Remove them from the Countries field."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"Het parceltype '%(ptype)s' is enkel beschikbaar voor zendingen naar "
"%(allowed)s.\n"
"Verwijder deze landen uit het Countries-veld, of kies een ander parceltype: "
"%(wrong)s"
msgstr ""
"The parcel type '%(ptype)s' is only available for shipments to %(allowed)s.\n"
"Remove these countries from the Countries field, or pick another parcel "
"type: %(wrong)s"

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"Het parceltype '%(ptype)s' is enkel beschikbaar voor particuliere "
"ontvangers. '%(partner)s' is een bedrijf."
msgstr ""
"The parcel type '%(ptype)s' is only available for private recipients. "
"'%(partner)s' is a company."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"Het parceltype '%(ptype)s' is enkel beschikbaar voor zakelijke ontvangers. "
"'%(partner)s' is een particulier."
msgstr ""
"The parcel type '%(ptype)s' is only available for business recipients. "
"'%(partner)s' is a private individual."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"Voeg minstens één parcel toe in de DHL Parcels-tab op deze delivery, of "
"kies een DHL-verzendmethode met een vast parceltype."
msgstr ""
"Add at least one parcel in the DHL Parcels tab on this delivery, or pick a "
"DHL shipping method with a fixed parcel type."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"Eén van de parcels in de DHL Parcels-tab heeft geen type. Vul het type aan "
"vóór je valideert."
msgstr ""
"One of the parcels in the DHL Parcels tab has no type. Fill in the type "
"before validating."

