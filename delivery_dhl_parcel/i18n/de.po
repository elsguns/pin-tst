#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid "Pick a Parcel type on the DHL shipping method '%s'."
msgstr "Wählen Sie einen Pakettyp auf der DHL-Versandart '%s'."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"DHL Parcel does not deliver to the following countries: %s.\n"
"Remove them from the Countries field."
msgstr ""
"DHL Parcel liefert nicht in folgende Länder: %s.\n"
"Entfernen Sie diese aus dem Feld Countries."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"The parcel type '%(ptype)s' is only available for shipments to %(allowed)s.\n"
"Remove these countries from the Countries field, or pick a different parcel "
"type: %(wrong)s"
msgstr ""
"Der Pakettyp '%(ptype)s' ist nur für Sendungen nach %(allowed)s verfügbar.\n"
"Entfernen Sie diese Länder aus dem Feld Countries oder wählen Sie einen "
"anderen Pakettyp: %(wrong)s"

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"The parcel type '%(ptype)s' is only available for private recipients. "
"'%(partner)s' is a company."
msgstr ""
"Der Pakettyp '%(ptype)s' ist nur für Privatempfänger verfügbar. "
"'%(partner)s' ist ein Unternehmen."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"The parcel type '%(ptype)s' is only available for business recipients. "
"'%(partner)s' is a private individual."
msgstr ""
"Der Pakettyp '%(ptype)s' ist nur für Geschäftsempfänger verfügbar. "
"'%(partner)s' ist eine Privatperson."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"Add at least one parcel in the DHL Parcels tab on this delivery, or pick a "
"DHL shipping method with a fixed parcel type."
msgstr ""
"Fügen Sie mindestens ein Paket im DHL Parcels-Reiter dieser Lieferung hinzu "
"oder wählen Sie eine DHL-Versandart mit einem festen Pakettyp."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"One of the parcels in the DHL Parcels tab has no type. Set the type before "
"validating."
msgstr ""
"Eines der Pakete im DHL Parcels-Reiter hat keinen Typ. Legen Sie den Typ "
"vor dem Validieren fest."

