msgstr "Colis DHL"

#. module: delivery_dhl_parcel
#: model:ir.model.fields,help:delivery_dhl_parcel.field_stock_picking__dhl_parcel_line_ids
msgid ""
"Used only for DHL methods with parcel type 'Gemengd' (MIX): one row per "
"parcel, type + qty + optional weight."
msgstr ""
"Utilisé uniquement pour les méthodes DHL avec type de colis 'Mixte' (MIX) : "
"une ligne par colis, type + quantité + poids optionnel."

#. module: delivery_dhl_parcel
#: model:ir.model.fields,field_description:delivery_dhl_parcel.field_dhl_parcel_line__quantity
