#. odoo-python
#: code:addons/delivery_dhl_parcel/models/dhl_parcel_line.py:0
msgid ""
"Envelope 50 to 500 g is only available for shipments to the Netherlands "
"(destination: %s)."
msgstr ""
"Enveloppe 50 à 500 g n'est disponible que pour les envois vers les Pays-Bas "
"(destination : %s)."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid "Pick a Parcel type on the DHL shipping method '%s'."
msgstr "Choisissez un Type de colis sur la méthode d'expédition DHL '%s'."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"DHL Parcel does not deliver to the following countries: %s.\n"
"Remove them from the Countries field."
msgstr ""
"DHL Parcel ne livre pas dans les pays suivants : %s.\n"
"Retirez-les du champ Pays."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"The parcel type '%(ptype)s' is only available for shipments to %(allowed)s.\n"
"Remove these countries from the Countries field, or pick a different parcel "
"type: %(wrong)s"
msgstr ""
"Le type de colis '%(ptype)s' n'est disponible que pour les envois vers "
"%(allowed)s.\n"
"Retirez ces pays du champ Pays, ou choisissez un autre type de colis : "
"%(wrong)s"

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"The parcel type '%(ptype)s' is only available for private recipients. "
"'%(partner)s' is a company."
msgstr ""
"Le type de colis '%(ptype)s' n'est disponible que pour les destinataires "
"particuliers. '%(partner)s' est une entreprise."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"The parcel type '%(ptype)s' is only available for business recipients. "
"'%(partner)s' is a private individual."
msgstr ""
"Le type de colis '%(ptype)s' n'est disponible que pour les destinataires "
"professionnels. '%(partner)s' est un particulier."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"Add at least one parcel in the DHL Parcels tab on this delivery, or pick a "
"DHL shipping method with a fixed parcel type."
msgstr ""
"Ajoutez au moins un colis dans l'onglet DHL Parcels de ce bon de livraison, "
"ou choisissez une méthode d'expédition DHL avec un type de colis fixe."

#. module: delivery_dhl_parcel
#. odoo-python
#: code:addons/delivery_dhl_parcel/models/delivery_carrier.py:0
msgid ""
"One of the parcels in the DHL Parcels tab has no type. Set the type before "
"validating."
msgstr ""
"L'un des colis de l'onglet DHL Parcels n'a pas de type. Définissez le type "
"avant de valider."

